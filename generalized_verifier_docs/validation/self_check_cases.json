{
  "comment": "Three-control self-validation matrix for six core engines. Every input is committed under validation/fixtures, so a clean checkout is sufficient. Placeholders: {REPO}=repo root, {GV}=generalized_verifier_docs, {VAL}=generalized_verifier_docs/validation, {FIXTURES}=validation/fixtures, {GEN}=runtime-generated tamper inputs dir.",
  "cases": [
    {
      "id": "01-positive",
      "verifier": "01_structural_api_gate.py",
      "control": "positive",
      "description": "Known-good reference implementation against the committed arithmetic test fixture.",
      "argv": [
        "--test",
        "{FIXTURES}/arithmetic/arithmetic_test.cpp",
        "--header",
        "{FIXTURES}/arithmetic/.meta/example.h",
        "--source",
        "{FIXTURES}/arithmetic/.meta/example.cpp"
      ],
      "expect": {
        "exit": 0,
        "stdout_contains": [
          "VERDICT: PASS"
        ]
      }
    },
    {
      "id": "01-fault",
      "verifier": "01_structural_api_gate.py",
      "control": "fault",
      "description": "Fault control: the candidate uses a foreign namespace and lacks the API required by the test.",
      "argv": [
        "--test",
        "{FIXTURES}/arithmetic/arithmetic_test.cpp",
        "--header",
        "{FIXTURES}/candidates/foreign/arithmetic.h",
        "--source",
        "{FIXTURES}/candidates/foreign/arithmetic.cpp"
      ],
      "expect": {
        "exit": 1,
        "stdout_contains": [
          "VERDICT: FAIL",
          "required symbol 'add' not declared"
        ]
      }
    },
    {
      "id": "01-tamper",
      "verifier": "01_structural_api_gate.py",
      "control": "tamper",
      "description": "Tamper control: an independently stored foreign candidate is paired with the arithmetic test.",
      "rationale": "The test-derived demo namespace must not be satisfied by similarly named symbols in a foreign namespace.",
      "argv": [
        "--test",
        "{FIXTURES}/arithmetic/arithmetic_test.cpp",
        "--header",
        "{FIXTURES}/candidates/foreign/arithmetic.h",
        "--source",
        "{FIXTURES}/candidates/foreign/arithmetic.cpp"
      ],
      "expect": {
        "exit": 1,
        "stdout_contains": [
          "VERDICT: FAIL",
          "not declared in namespace"
        ]
      }
    },
    {
      "id": "03-positive",
      "verifier": "03_two_stage_build_verifier.py",
      "control": "positive",
      "description": "Known-good reference implementation through the real two-stage g++ build.",
      "argv": [
        "--fixture-dir",
        "{FIXTURES}/arithmetic",
        "--header",
        "{FIXTURES}/arithmetic/.meta/example.h",
        "--source",
        "{FIXTURES}/arithmetic/.meta/example.cpp"
      ],
      "expect": {
        "exit": 0,
        "stdout_contains": [
          "STATUS: PASS"
        ]
      }
    },
    {
      "id": "03-fault",
      "verifier": "03_two_stage_build_verifier.py",
      "control": "fault",
      "description": "Fault control: one declared API function intentionally has no definition.",
      "argv": [
        "--fixture-dir",
        "{FIXTURES}/arithmetic",
        "--header",
        "{FIXTURES}/candidates/link-fail/arithmetic.h",
        "--source",
        "{FIXTURES}/candidates/link-fail/arithmetic.cpp"
      ],
      "expect": {
        "exit": 1,
        "stdout_contains": [
          "STATUS: LE",
          "LINKER ERROR"
        ]
      }
    },
    {
      "id": "03-tamper",
      "verifier": "03_two_stage_build_verifier.py",
      "control": "tamper",
      "description": "Tamper control: a foreign-namespace candidate is compiled against the arithmetic test.",
      "rationale": "The official test must fail to compile when the candidate does not expose the required namespace.",
      "argv": [
        "--fixture-dir",
        "{FIXTURES}/arithmetic",
        "--header",
        "{FIXTURES}/candidates/foreign/arithmetic.h",
        "--source",
        "{FIXTURES}/candidates/foreign/arithmetic.cpp"
      ],
      "expect": {
        "exit": 1,
        "stdout_contains": [
          "STATUS: CE-2"
        ]
      }
    },
    {
      "id": "04-positive",
      "verifier": "04_differential_semantic_verifier.py",
      "control": "positive",
      "description": "Reference implementation as candidate: must score 4/4 assertions.",
      "argv": [
        "--fixture-dir",
        "{FIXTURES}/arithmetic",
        "--header",
        "{FIXTURES}/arithmetic/.meta/example.h",
        "--source",
        "{FIXTURES}/arithmetic/.meta/example.cpp"
      ],
      "expect": {
        "exit": 0,
        "stdout_contains": [
          "VERDICT: PASS (score 1.0)"
        ]
      }
    },
    {
      "id": "04-fault",
      "verifier": "04_differential_semantic_verifier.py",
      "control": "fault",
      "description": "Fault control: addition is correct but multiplication has two semantic regressions.",
      "argv": [
        "--fixture-dir",
        "{FIXTURES}/arithmetic",
        "--header",
        "{FIXTURES}/candidates/semantic-fail/arithmetic.h",
        "--source",
        "{FIXTURES}/candidates/semantic-fail/arithmetic.cpp"
      ],
      "expect": {
        "exit": 1,
        "stdout_contains": [
          "VERDICT: FAIL (score 0.5)",
          "semantic regression"
        ]
      }
    },
    {
      "id": "04-tamper",
      "verifier": "04_differential_semantic_verifier.py",
      "control": "tamper",
      "description": "Tamper control: the semantic oracle is paired with a foreign-namespace candidate.",
      "rationale": "The differential verifier must report a candidate build failure instead of silently accepting a mismatched implementation.",
      "argv": [
        "--fixture-dir",
        "{FIXTURES}/arithmetic",
        "--header",
        "{FIXTURES}/candidates/foreign/arithmetic.h",
        "--source",
        "{FIXTURES}/candidates/foreign/arithmetic.cpp"
      ],
      "expect": {
        "exit": 1,
        "stdout_contains": [
          "BUILD_FAIL",
          "VERDICT: FAIL"
        ]
      }
    },
    {
      "id": "04-fault-build-fail-le",
      "verifier": "04_differential_semantic_verifier.py",
      "control": "fault",
      "description": "Fault control (verifier-v2 fix 1): the candidate declares a function with no definition, so the official test fails to link (LE) and the engine reports candidate BUILD_FAIL. Wrapper G03 maps this engine report to an unscored (not_run/null) candidate kernel with the build failure preserved in facts, deduplicating the G02 build penalty; that mapping is asserted end-to-end in tests/test_generalized_cpp_verifiers.py.",
      "argv": [
        "--fixture-dir",
        "{FIXTURES}/arithmetic",
        "--header",
        "{FIXTURES}/candidates/link-fail/arithmetic.h",
        "--source",
        "{FIXTURES}/candidates/link-fail/arithmetic.cpp"
      ],
      "expect": {
        "exit": 1,
        "stdout_contains": [
          "BUILD_FAIL",
          "LE",
          "VERDICT: FAIL"
        ]
      }
    },
    {
      "id": "05-positive",
      "verifier": "05_response_integrity_verifier.py",
      "control": "positive",
      "description": "Compact clean generation with two complete file listings.",
      "argv": [
        "--response",
        "{FIXTURES}/responses/complete.txt"
      ],
      "expect": {
        "exit": 0,
        "stdout_contains": [
          "VERDICT: OK"
        ]
      }
    },
    {
      "id": "05-fault",
      "verifier": "05_response_integrity_verifier.py",
      "control": "fault",
      "description": "Compact degenerate CJK-phrase loop running to the end of the generation.",
      "argv": [
        "--response",
        "{FIXTURES}/responses/loop.txt"
      ],
      "expect": {
        "exit": 1,
        "stdout_contains": [
          "VERDICT: LOOP"
        ]
      }
    },
    {
      "id": "05-tamper",
      "verifier": "05_response_integrity_verifier.py",
      "control": "tamper",
      "description": "Deliberately corrupted input: the known-good generation with its final closing fence removed (generated at runtime by drop_last_fence).",
      "rationale": "Sensible behavior: the deliverable's last fence is never closed, so the verdict must be TRUNCATED (cut mid-block), not OK. A silent PASS would mean truncation detection is dead.",
      "generate": {
        "kind": "drop_last_fence",
        "source": "{FIXTURES}/responses/complete.txt",
        "name": "05_tamper_unclosed_fence.txt"
      },
      "argv": [
        "--response",
        "{GEN}/05_tamper_unclosed_fence.txt"
      ],
      "expect": {
        "exit": 1,
        "stdout_contains": [
          "VERDICT: TRUNCATED"
        ]
      }
    },
    {
      "id": "05-cap-cut-truncated",
      "verifier": "05_response_integrity_verifier.py",
      "control": "fault",
      "description": "Fault control (verifier-v2 fix 3): a generation with two complete file listings that is then cut mid-prose by the output-token cap, with harness token counts supplied (--gen-tokens equals --max-tokens). Without token counts this same input is OK, so this case exercises the cap-aware TRUNCATED branch that the training adapter now feeds.",
      "argv": [
        "--response",
        "{FIXTURES}/responses/cap_cut.txt",
        "--gen-tokens",
        "8192",
        "--max-tokens",
        "8192"
      ],
      "expect": {
        "exit": 1,
        "stdout_contains": [
          "VERDICT: TRUNCATED",
          "output cap"
        ]
      }
    },
    {
      "id": "05-loop-at-cap",
      "verifier": "05_response_integrity_verifier.py",
      "control": "fault",
      "description": "Fault control (verifier-v2 fix 3): the degenerate CJK-phrase loop with harness token counts showing the cap was hit. LOOP must outrank TRUNCATED (precedence LOOP > TRUNCATED), matching the adapter's escalation of loop degeneration to the full -1.0 penalty.",
      "argv": [
        "--response",
        "{FIXTURES}/responses/loop.txt",
        "--gen-tokens",
        "8192",
        "--max-tokens",
        "8192"
      ],
      "expect": {
        "exit": 1,
        "stdout_contains": [
          "VERDICT: LOOP"
        ]
      }
    },
    {
      "id": "06-positive",
      "verifier": "06_candidate_boundary_verifier.py",
      "control": "positive",
      "description": "Clean response: both editable arithmetic files are listed exactly once.",
      "argv": [
        "--response",
        "{FIXTURES}/responses/complete.txt",
        "--editable",
        "arithmetic.h",
        "--editable",
        "arithmetic.cpp"
      ],
      "expect": {
        "exit": 0,
        "stdout_contains": [
          "VERDICT: OK"
        ]
      }
    },
    {
      "id": "06-fault",
      "verifier": "06_candidate_boundary_verifier.py",
      "control": "fault",
      "description": "Fault control: response contains a file outside the editable set.",
      "argv": [
        "--response",
        "{FIXTURES}/responses/forbidden.txt",
        "--editable",
        "arithmetic.h",
        "--editable",
        "arithmetic.cpp"
      ],
      "expect": {
        "exit": 1,
        "stdout_contains": [
          "FORBIDDEN_FILE",
          "VERDICT: FAIL"
        ]
      }
    },
    {
      "id": "06-tamper",
      "verifier": "06_candidate_boundary_verifier.py",
      "control": "tamper",
      "description": "Tamper control: a clean arithmetic response is checked against a foreign editable set.",
      "rationale": "Sensible behavior: every listed file is outside task B's editable set, so the verdict must be FAIL with FORBIDDEN_FILE issues. A silent PASS would mean the editable-set boundary is not enforced.",
      "argv": [
        "--response",
        "{FIXTURES}/responses/complete.txt",
        "--editable",
        "foreign.h",
        "--editable",
        "foreign.cpp"
      ],
      "expect": {
        "exit": 1,
        "stdout_contains": [
          "FORBIDDEN_FILE",
          "VERDICT: FAIL"
        ]
      }
    },
    {
      "id": "07-positive",
      "verifier": "07_warning_hygiene_classifier.py",
      "control": "positive",
      "description": "Compact clean build log with no compiler diagnostics.",
      "argv": [
        "--stderr",
        "{FIXTURES}/logs/clean.stderr.txt"
      ],
      "expect": {
        "exit": 0,
        "stdout_contains": [
          "VERDICT: PASS"
        ]
      }
    },
    {
      "id": "07-fault",
      "verifier": "07_warning_hygiene_classifier.py",
      "control": "fault",
      "description": "Compact missing-include diagnostic for uint32_t.",
      "argv": [
        "--stderr",
        "{FIXTURES}/logs/missing-cstdint.stderr.txt"
      ],
      "expect": {
        "exit": 1,
        "stdout_contains": [
          "VERDICT: FAIL",
          "missing-include",
          "cstdint"
        ]
      }
    },
    {
      "id": "07-tamper",
      "verifier": "07_warning_hygiene_classifier.py",
      "control": "tamper",
      "description": "Deliberately corrupted input: the known-good clean log of one build with a foreign error block from a different failing build appended (generated at runtime by concat).",
      "rationale": "Sensible behavior: the classifier trusts only the diagnostic content, never the filename or origin label, so the injected unused-parameter errors must flip the verdict to FAIL with dominant class unused-parameter. A silent PASS would mean it is not actually parsing the text.",
      "generate": {
        "kind": "concat",
        "sources": [
          "{FIXTURES}/logs/clean.stderr.txt",
          "{FIXTURES}/logs/unused-parameter.stderr.txt"
        ],
        "name": "07_tamper_mixed_log.txt"
      },
      "argv": [
        "--stderr",
        "{GEN}/07_tamper_mixed_log.txt"
      ],
      "expect": {
        "exit": 1,
        "stdout_contains": [
          "VERDICT: FAIL",
          "unused-parameter"
        ]
      }
    }
  ]
}
